# Local Postgres (Docker) — same variable points at hosted Postgres in production
POSTGRES_URL=postgresql://app:app@localhost:5432/app

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public app URL (sitemap, canonical links, preview card)
APP_URL=http://localhost:3000

# Resend — email verification + password reset. Without a key, emails print to the terminal.
RESEND_API_KEY=
EMAIL_FROM="QR Studio <onboarding@resend.dev>"

# Vercel Blob — logo uploads in production. Without a token, uploads save to a local folder.
BLOB_READ_WRITE_TOKEN=

# Storage driver override — "local" or "blob". Leave unset to auto-select:
# Blob in production when BLOB_READ_WRITE_TOKEN is set, otherwise the local folder.
STORAGE_DRIVER=
